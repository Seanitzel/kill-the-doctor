{
  "appId": "com.ktd.northline",
  "appName": "KTD",
  "webDir": "dist",
  "backgroundColor": "#0c1c27",
  "initialFocus": false,
  "loggingBehavior": "debug",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0c1c27",
    "preferredContentMode": "mobile",
    "scrollEnabled": false
  },
  "android": {
    "backgroundColor": "#0c1c27",
    "captureInput": true
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#0c1c27"
    }
  }
}
