{
  "name": "kill-the-doctor",
  "version": "3.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "start": "node scripts/serve.mjs",
    "native:sync": "npm run build && node scripts/sync-native-version.mjs && cap sync",
    "native:test:sync": "vite build --mode native-test && node scripts/sync-native-version.mjs && cap sync",
    "native:android": "node scripts/build-native.mjs android",
    "native:ios": "node scripts/build-native.mjs ios",
    "native:run:ios": "node scripts/build-native.mjs ios --run",
    "native:run:android": "node scripts/build-native.mjs android --run",
    "native:qa:ios": "node scripts/build-native.mjs ios --qa --run",
    "native:qa:android": "node scripts/build-native.mjs android --qa --run",
    "build:pages": "vite build --mode github-pages --outDir artifacts/github-pages",
    "native:doctor": "node scripts/native-doctor.mjs",
    "native:release:android": "node scripts/build-native.mjs android --release",
    "native:archive:ios": "node scripts/build-native.mjs ios --release",
    "native:open:android": "cap open android",
    "native:open:ios": "cap open ios",
    "native:verify": "node scripts/verify-native-assets.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "lucide-vue-next": "^0.468.0",
    "three": "^0.180.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.7"
  }
}
